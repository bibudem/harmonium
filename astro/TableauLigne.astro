---
/* <TableauLigne> : un <tr> ; `survol` le surligne au survol (voir src/composants/tableau.css). */
import '../src/composants/tableau.css'
import { classes, fusionnerStyles } from './styles.ts'

interface Props {
  survol?: boolean
  class?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { survol = false, class: classe, style, ...reste } = Astro.props
---

<tr class:list={['bib-tableau__rangee', { 'bib-tableau__rangee--survol': survol }, classes(classe)]} style={fusionnerStyles(style)} {...reste}><slot /></tr>
