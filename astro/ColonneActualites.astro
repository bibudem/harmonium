---
/*
 * <ColonneActualites> : une colonne titrée d'une section « Quoi de neuf ». Produit le HTML documenté dans
 * src/composants/colonne-actualites.css et importe cette feuille.
 *
 *   <ColonneActualites titre="Nouvelles" textePlus="Toutes nos nouvelles" lienPlus="/nouvelles/">
 *     <ListeActualites elements={…} />
 *   </ColonneActualites>
 *
 * `titreMasque` : le h3 reste pour les lecteurs d'écran seulement. `plusCentre` : le bouton, centré sous la
 * liste, est un bouton plein. `externe` : moreLink s'ouvre dans un nouvel onglet. `id` : celui du h3 (relié à
 * l'onglet de <QuoiDeNeuf>) ; généré sinon.
 */
import '../src/composants/colonne-actualites.css'
import Bouton from './Bouton.astro'
import { idUnique } from './ids.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'


interface Props {
  titre?: string
  niveauTitre?: 2 | 3 | 4 | 5 | 6
  id?: string
  textePlus?: string
  lienPlus?: string
  externe?: boolean
  titreMasque?: boolean
  plusCentre?: boolean
  class?: string
  style?: Style
}

const { titre: title, niveauTitre = 3, id: idDonne, textePlus: moreText, lienPlus: moreLink, externe = false, titreMasque = false, plusCentre = false, class: classe, style } = Astro.props
if (moreLink && !moreText?.trim()) throw new Error('ColonneActualites : le lien de fin nécessite un libellé.')
const Titre = `h${niveauTitre}` as 'h3'
const id = idDonne ?? idUnique('colonne-actualites')
---

<section
  class:list={['bib-colonne-actualites', { 'bib-colonne-actualites--titre-masque': titreMasque, 'bib-colonne-actualites--plus-centre': plusCentre }, classes(classe)]}
  style={fusionnerStyles(style)}
  aria-labelledby={id}
  data-colonne={id}
>
  <Titre id={id} class="bib-colonne-actualites__titre">{title}</Titre>
  <div class="bib-colonne-actualites__corps"><slot /></div>
  {
    moreLink && (
      <div class="bib-colonne-actualites__plus">
        <Bouton secondaire={!plusCentre} primary={plusCentre} href={moreLink} {...(externe && { target: '_blank', rel: 'noopener noreferrer' })}>
          {moreText}
        </Bouton>
      </div>
    )
  }
</section>
