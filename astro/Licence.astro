---
/*
 * <Licence> : la mention de licence CC BY 4.0 du pied de page. Produit le HTML documenté dans
 * src/composants/licence.css et importe cette feuille.
 *
 *   <Licence />
 *   <Licence href="/licence/" texte="Sauf indications contraires, ce site est sous licence CC BY 4.0" />
 */
import '../src/composants/licence.css'
import { classes } from './styles.ts'

interface Props {
  /** Page des conditions d'utilisation */
  href?: string
  texte?: string
  class?: string
}

const { href = '/conditions-utilisation/', texte = 'Sauf indications contraires, ce site est sous licence CC BY 4.0', class: classe } = Astro.props
---

<div class:list={['bib-licence', classes(classe)]} prefix="cc: http://creativecommons.org/ns# dct: http://purl.org/dc/terms/">
  <span class="bib-licence__cc" aria-hidden="true"></span>
  <span class="bib-licence__cc bib-licence__cc--by" aria-hidden="true"></span>
  <a href={href} rel="license">{texte}</a>
</div>
