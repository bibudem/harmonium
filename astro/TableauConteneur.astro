---
/*
 * <TableauConteneur> : la zone qui défile, en plusieurs morceaux (voir
 * <Tableau> pour le tableau complet en un seul). `component={Paper}` (ou tout composant) donne la
 * surface ; une balise (string) change la balise. La zone prend le nom du tableau, s'il en a un ;
 * role="group" plutôt que « region » : plusieurs tableaux sans nom propre sur une page donneraient
 * plusieurs repères identiques.
 */
import '../src/composants/tableau.css'
import { classes, fusionnerStyles } from './styles.ts'


interface Props {
  balise?: unknown
  'aria-label'?: string
  class?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { balise: _composant, 'aria-label': libelle, class: classe, style, ...reste } = Astro.props
const contenu = Astro.slots.has('default') ? await Astro.slots.render('default') : ''
const nomTableau = contenu.match(/<table[^>]*\saria-label="([^"]*)"/)?.[1]
const nom = libelle ?? nomTableau ?? 'Tableau'
---

<div class:list={['bib-tableau-zone', classes(classe)]} style={fusionnerStyles(style)} role="group" aria-label={nom} tabindex="0" data-tableau-defilant {...reste} set:html={contenu}></div>
