---
/*
 * <Bouton> : produit le HTML documenté dans src/composants/bouton.css et importe cette feuille.
 * Un <a> si `href` est fourni, sinon un <button>.
 *
 *   <Bouton href="/services/">Réserver une salle</Bouton>
 *   <Bouton secondaire>Annuler</Bouton>
 *
 * - Plein par défaut ; `secondaire` : contour. `variante` (plein, contour) et `couleur` (bleuFonce,
 *   bleuPrincipal) précisent.
 * - Avec href : flèche de fin → (autre page des bibliothèques) ou ↗ (autre site, nouvel onglet) ;
 *   jamais pour un PDF, un courriel ni un téléphone. Un PDF s'ouvre dans un nouvel onglet ; PDF
 *   et nouvel onglet sont annoncés en texte masqué.
 * - `retour` : flèche vers la gauche avant le texte, au lieu de la flèche de fin.
 * - `clair` : variante pour fond foncé. `sansFleche` retire la flèche. `iconeSeule` : bouton à icône seule.
 */
import '../src/composants/bouton.css'
import { analyserLien, annonceLien, relDuLien, versAilleurs } from './liens.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  secondaire?: boolean
  href?: string
  /** bleuFonce ou bleuPrincipal */
  couleur?: 'bleuFonce' | 'bleuPrincipal'
  variante?: 'plein' | 'contour'
  disabled?: boolean
  taille?: 'petit' | 'moyen' | 'grand'
  clair?: boolean
  sansFleche?: boolean
  /** Bouton à icône seule (SVG dans le contenu) : nommer le bouton avec aria-label */
  iconeSeule?: boolean
  retour?: boolean
  target?: string
  rel?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { secondaire = false, href, couleur, variante, taille = 'moyen', disabled = false, clair = false, sansFleche = false, iconeSeule = false, retour = false, target, rel, type = 'button', class: classe, style, ...reste } = Astro.props

const apparence = variante ?? (secondaire ? 'contour' : 'plein')
const teinte = couleur ?? (secondaire ? 'bleuPrincipal' : 'bleuFonce')
const COULEURS: Record<string, string> = { bleuFonce: 'bleu-fonce', bleuPrincipal: 'bleu-principal' }
const TAILLES: Record<string, string | undefined> = { petit: 'bib-bouton--petit', moyen: undefined, grand: 'bib-bouton--grand' }

const estLien = typeof href === 'string'
if (estLien && !href.trim()) throw new Error('Bouton : une adresse non vide est requise.')
const analyse = analyserLien(href, Astro.site?.origin ?? Astro.url.origin)
const cible = analyse.pdf ? '_blank' : target
const nouvelOnglet = cible === '_blank'
const relFinal = estLien ? relDuLien(rel, analyse.interne, nouvelOnglet) : rel
const annonce = estLien ? annonceLien({ pdf: analyse.pdf, nouvelOnglet }) : ''
const externe = versAilleurs(analyse, nouvelOnglet)
const avecFin = estLien && !analyse.pdf && !analyse.courrielOuTelephone && !sansFleche && !retour && !iconeSeule
const listeClasses = ['bib-bouton', TAILLES[taille], `bib-bouton--${apparence === 'contour' ? 'contour' : 'plein'}`, `bib-bouton--${COULEURS[teinte] ?? 'bleu-fonce'}`, { 'bib-bouton--clair': clair, 'bib-bouton--icone': iconeSeule }, classes(classe)]
---

{
  estLien ? (
    <a {...reste} href={disabled ? undefined : href} role={disabled ? 'link' : undefined} aria-disabled={disabled ? 'true' : undefined} target={disabled ? undefined : cible} rel={relFinal} class:list={listeClasses} style={fusionnerStyles(style)}>
      {retour && <span class="bib-bouton__debut" aria-hidden="true" />}
      <span class="bib-bouton__libelle"><slot /></span>
      {annonce && <span class="bib-masque">{annonce}</span>}
      {avecFin && <span class:list={['bib-bouton__fin', { 'bib-bouton__fin--externe': externe }]} aria-hidden="true" />}
    </a>
  ) : (
    <button {...reste} type={type} disabled={disabled} class:list={listeClasses} style={fusionnerStyles(style)}>
      <span class="bib-bouton__libelle"><slot /></span>
    </button>
  )
}
