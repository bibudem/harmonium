---
/*
 * <Typographie> : produit le HTML documenté dans src/composants/typographie.css et importe cette
 * feuille.
 *
 * `variante` donne l'apparence, `balise` la balise : variante="titre-2" balise="h1" rend un <h1>
 * qui a l'apparence d'un titre 2. Sans balise, elle suit la variante (titres → h1-h6, texte et
 * sous-titres → p, autres → span).
 */
import '../src/composants/typographie.css'
import { couleurTheme } from './couleurs.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'
// Balises de texte (sans élément vide comme img ou br, qui n'ont pas d'enfants)
type BaliseTexte = 'p' | 'span' | 'div' | 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'figcaption' | 'li' | 'label' | 'strong' | 'em' | 'small'


interface Props {
  variante?: string
  balise?: string
  margeBas?: boolean
  paragraphe?: boolean
  surUneLigne?: boolean
  alignement?: 'gauche' | 'centre' | 'droite' | 'justifie'
  /** Un rôle (texte, texte-secondaire, accent, sur-fonce) ou une couleur de la palette (bleuPrincipal…) */
  couleur?: string
  id?: string
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { variante: varianteDemandee = 'texte', balise: component, margeBas: gutterBottom = false, paragraphe: paragraph = false, surUneLigne: noWrap = false, alignement: align, couleur: color, class: classe, style, ...reste } = Astro.props

const variante = varianteDemandee
const BALISES: Record<string, string> = { 'titre-1': 'h1', 'titre-2': 'h2', 'titre-3': 'h3', 'titre-4': 'h4', 'titre-editorial': 'h4', 'titre-5': 'h5', 'titre-6': 'h6', 'sous-titre': 'p', 'sous-titre-petit': 'p', texte: 'p', 'texte-petit': 'p', herite: 'p' }
const Balise = (component ?? (paragraph ? 'p' : BALISES[variante]) ?? 'span') as BaliseTexte
const styleFinal = fusionnerStyles({ color: couleurTheme(color), textAlign: align ? ({ gauche: 'left', centre: 'center', droite: 'right', justifie: 'justify' } as Record<string, string>)[align] : undefined }, style)
---

<Balise
  class:list={['bib-typographie', `bib-typographie--${variante}`, { 'bib-typographie--marge-bas': gutterBottom, 'bib-typographie--paragraphe': paragraph, 'bib-typographie--sans-retour': noWrap }, classes(classe)]}
  style={styleFinal}
  {...reste}><slot /></Balise
>
