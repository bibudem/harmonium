---
/*
 * <Galerie> : des figures côte à côte (<FigureGalerie>). Produit le HTML documenté dans
 * src/composants/galerie.css et importe cette feuille.
 */
import '../src/composants/galerie.css'
import { classes } from './styles.ts'

interface Props {
  class?: string
}

const { class: classe } = Astro.props
---

<div class:list={['bib-galerie', classes(classe)]}>
  <slot />
</div>
