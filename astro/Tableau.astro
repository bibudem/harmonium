---
/*
 * <Tableau> : un tableau complet, dans une zone sur surface claire qui défile à l'horizontale
 * quand il est plus large que l'écran. Produit le HTML documenté dans src/composants/tableau.css
 * et importe cette feuille.
 *
 *   <Tableau titre="Frais de retard">
 *     <thead><tr><th>Document</th><th>Frais</th></tr></thead>
 *     <tbody><tr><th>Livre</th><td>5 $</td></tr></tbody>
 *   </Tableau>
 *
 * Le slot donne <thead>, <tbody>, <tr> et les cellules : les cellules d'en-tête de <thead> (ou
 * marquées data-cellule) deviennent des <th scope="col"> et les <th> sans portée la reçoivent
 * (scope="row" dans le corps). La zone est une région nommée d'après `titre` (role="region"),
 * atteignable au clavier. <TableauConteneur> + <TableauTable> + leurs parties donnent
 * le même HTML en plusieurs morceaux.
 */
import '../src/composants/tableau.css'
import { semantiqueTableau } from './semantique-tableau.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  /** Nom du tableau, repris par la zone défilante */
  titre?: string
  /** Cellules plus serrées */
  size?: 'small' | 'medium'
  /** Style du <table> (largeur minimale) */
  style?: Style
  class?: string
  /** Contenu repris de React */
  className?: string
  [attribut: string]: unknown
}

const { titre, size = 'medium', style, class: classe, className, ...reste } = Astro.props
const contenu = semantiqueTableau(Astro.slots.has('default') ? await Astro.slots.render('default') : '')
---

<div role="region" aria-label={titre ?? 'Tableau'} tabindex="0" class="bib-tableau-zone" data-tableau-defilant>
  <table class:list={['bib-tableau', { 'bib-tableau--compact': size === 'small' }, classes(classe, className)]} aria-label={titre} style={fusionnerStyles(style)} {...reste} set:html={contenu}></table>
</div>
