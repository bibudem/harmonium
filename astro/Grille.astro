---
/*
 * <Grille> : une grille de 12 colonnes, sans JavaScript. Produit le HTML documenté dans
 * src/composants/grille.css et importe cette feuille.
 *
 *   <Grille conteneur ecart={2}>
 *     <Grille taille={{ xs: 12, md: 6 }}>…</Grille>
 *     <Grille taille={{ xs: 12, md: 6 }}>…</Grille>
 *   </Grille>
 *
 * `conteneur` : le parent des blocs (boîte flex) ; `ecart` (en pas de l'échelle, ou chaîne CSS), `ecartRangees` et
 * `ecartColonnes` : ses écarts (la valeur xs seulement). `taille` : colonnes du bloc (0 à 12, `grow`, `auto`),
 * seuil par seuil. `decalage` : colonnes de marge à gauche, ou `auto`. `direction`, `retour`, `alignementVertical`,
 * `alignementHorizontal` : réglages flex du conteneur ; `ecartDirect` : un écart CSS qui ne change pas le calcul des largeurs. `balise` : la balise (div par défaut).
 */
import '../src/composants/grille.css'
import { classes, espacement, fusionnerStyles, parPoint, type Responsive, type Style } from './styles.ts'

type Taille = number | string | boolean
type Decalage = number | string


interface Props {
  conteneur?: boolean
  taille?: Responsive<Taille>
  decalage?: Responsive<Decalage>
  ecart?: Responsive<number | string>
  ecartRangees?: Responsive<number | string>
  ecartColonnes?: Responsive<number | string>
  direction?: 'row' | 'row-reverse' | 'column' | 'column-reverse'
  retour?: 'wrap' | 'nowrap' | 'wrap-reverse'
  alignementVertical?: string
  alignementHorizontal?: string
  /** Écart CSS direct ; ne change pas le calcul des largeurs */
  ecartDirect?: number | string
  balise?: string
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { conteneur: container = false, taille: size, decalage: offset, ecart: spacing, ecartRangees: rowSpacing, ecartColonnes: columnSpacing, direction, retour: wrap, alignementVertical: alignItems, alignementHorizontal: justifyContent, ecartDirect, balise: component = 'div', class: classe, style, ...reste } = Astro.props

const Balise = component
const attributs: Record<string, string> = {}
const variables: Record<string, string> = {}

const nombre = (v: unknown) => (typeof v === 'number' ? v : typeof v === 'string' && /^\d*\.?\d+$/.test(v.trim()) ? Number(v) : NaN)

for (const [point, valeur] of Object.entries(parPoint(size))) {
  if (valeur === 'grow' || valeur === true) attributs[`data-taille-${point}`] = 'grow'
  else if (valeur === 'auto') attributs[`data-taille-${point}`] = 'auto'
  else if (!Number.isNaN(nombre(valeur))) {
    attributs[`data-taille-${point}`] = 'n'
    // Une valeur hors bornes (14) ne déborde pas de la rangée
    variables[`--bib-grille-taille-${point}`] = String(Math.min(Math.max(nombre(valeur), 0), 12))
  }
}

for (const [point, valeur] of Object.entries(parPoint(offset))) {
  if (valeur === 'auto') attributs[`data-decalage-${point}`] = 'auto'
  else if (!Number.isNaN(nombre(valeur))) {
    attributs[`data-decalage-${point}`] = 'n'
    variables[`--bib-grille-decalage-${point}`] = String(nombre(valeur))
  }
}

// L'espacement responsive n'est pas pris en charge : on garde la valeur xs
const premier = (v: Responsive<number | string> | undefined) => (v !== null && typeof v === 'object' ? (parPoint(v).xs ?? Object.values(v)[0]) : v)
if (container) {
  variables['--bib-grille-ecart-lig'] = espacement(premier(rowSpacing ?? spacing)) ?? '0px'
  variables['--bib-grille-ecart-col'] = espacement(premier(columnSpacing ?? spacing)) ?? '0px'
}

const styleFinal = fusionnerStyles(
  variables,
  {
    flexDirection: direction,
    flexWrap: wrap,
    alignItems,
    justifyContent,
    gap: espacement(ecartDirect as number | string | undefined),
  },
  style,
)
---

<Balise class:list={['bib-grille', { 'bib-grille--conteneur': container }, classes(classe)]} style={styleFinal} {...attributs} {...reste}><slot /></Balise>
