---
/*
 * <Logo> : un logo de <Logos>, avec ou sans lien. L'image est importée (formats et tailles
 * d'astro:assets, 200 px de haut au plus) ou une adresse.
 */
import '../src/composants/logos.css'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Lien from './Lien.astro'
import { classes } from './styles.ts'

interface Props {
  image: ImageMetadata | string
  alt: string
  href?: string
  class?: string
}

const { image, alt, href, class: classe } = Astro.props
if (href && !alt?.trim()) throw new Error('Logo : un logo lié doit avoir un texte alt qui nomme sa destination.')
const HAUTEUR = 200
const svg = typeof image !== 'string' && image.format === 'svg'
const source = typeof image === 'string' ? image : image.src
const dimensions = typeof image === 'string' ? {} : { width: image.width, height: image.height }
const visuel =
  typeof image === 'string' || svg
    ? undefined
    : { src: image, alt: alt ?? '', formats: ['avif', 'webp'] as ('avif' | 'webp')[], fallbackFormat: 'webp' as const, width: Math.round((HAUTEUR * image.width) / image.height), height: HAUTEUR, loading: 'lazy' as const, decoding: 'async' as const }
---

{/* Sur une ligne : un blanc autour du visuel s'afficherait dans le lien */}
<div class:list={['bib-logo', classes(classe)]}>{href ? <Lien href={href}>{visuel ? <Picture {...visuel} /> : <img src={source} {...dimensions} alt={alt ?? ''} loading="lazy" decoding="async" />}</Lien> : visuel ? <Picture {...visuel} /> : <img src={source} {...dimensions} alt={alt ?? ''} loading="lazy" decoding="async" />}</div>
