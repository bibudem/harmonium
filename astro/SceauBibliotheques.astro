---
/*
 * <SceauBibliotheques> : le sceau des bibliothèques de l'UdeM. Produit le HTML documenté dans
 * src/composants/sceau.css et importe cette feuille. Les deux images SVG sont celles d'Harmonium
 * (dist/bib-sceau-u.svg et bib-sceau-anneau.svg) ; le texte tourne au survol du lien parent avec
 * bib-sceau.min.js (facultatif).
 *
 *   <a href="/"><SceauBibliotheques /></a>
 */
import '../src/composants/sceau.css'
import u from '../src/composants/sceau-u.svg?url'
import anneau from '../src/composants/sceau-anneau.svg?url'
import { classes } from './styles.ts'

interface Props {
  /** Nom accessible du sceau (le lien parent n'a pas d'autre texte) */
  nom?: string
  class?: string
  /** Contenu repris de React */
  className?: string
}

const { nom = 'Les bibliothèques, Université de Montréal – Accueil', class: classe, className } = Astro.props
---

<span class:list={['bib-sceau', classes(classe, className)]} role="img" aria-label={nom}>
  <img class="bib-sceau__u" src={u} alt="" width="302" height="302" loading="lazy" decoding="async" />
  <img class="bib-sceau__anneau" src={anneau} alt="" width="302" height="302" loading="lazy" decoding="async" />
</span>
