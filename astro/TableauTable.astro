---
/*
 * <TableauTable> : le <table> seul. Les <th> écrits sans
 * portée la reçoivent (col dans l'en-tête, row ailleurs).
 */
import '../src/composants/tableau.css'
import { semantiqueTableau } from './semantique-tableau.ts'
import { classes, fusionnerStyles } from './styles.ts'

interface Props {
  size?: 'small' | 'medium'
  class?: string
  className?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { size = 'medium', class: classe, className, style, stickyHeader: _collant, ...reste } = Astro.props
const contenu = semantiqueTableau(Astro.slots.has('default') ? await Astro.slots.render('default') : '')
---

<table class:list={['bib-tableau', { 'bib-tableau--compact': size === 'small' }, classes(classe, className)]} style={fusionnerStyles(style)} {...reste} set:html={contenu}></table>
