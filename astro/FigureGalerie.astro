---
/*
 * <FigureGalerie> : une figure de <Galerie>, photo recadrée et légende (le slot). L'image est une
 * image importée (formats et tailles d'astro:assets) ou une adresse.
 */
import '../src/composants/galerie.css'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Typographie from './Typographie.astro'
import { classes } from './styles.ts'

interface Props {
  image: ImageMetadata | string
  alt?: string
  class?: string
}

const { image, alt, class: classe } = Astro.props
---

<figure class:list={['bib-galerie__figure', classes(classe)]}>
  {
    typeof image === 'string' ? (
      <img src={image} alt={alt ?? ''} loading="lazy" decoding="async" />
    ) : (
      <Picture src={image} alt={alt ?? ''} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 800].filter((l) => l < image.width).concat(Math.min(image.width, 800))} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" decoding="async" />
    )
  }
  <Typographie variante="texte-petit" balise="figcaption" class="bib-galerie__legende">
    <slot />
  </Typographie>
</figure>
