---
/*
 * <CartePhoto> : une carte-lien à photo plein cadre. Produit le HTML documenté dans
 * src/composants/carte-photo.css et importe cette feuille.
 *
 *   <CartePhoto titre="Réserver une salle" description="Des salles pour vos projets." url="/salles/" image={photo} />
 *
 * `image` : image importée (formats modernes et tailles d'astro:assets) ou adresse. La photo est décorative.
 */
import '../src/composants/carte-photo.css'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  titre: string
  description: string
  url: string
  image: ImageMetadata | string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: Style
}

const { titre, description, url, image, class: classe, className, style, ...reste } = Astro.props

if (!image) throw new Error('CartePhoto : la propriété `image` est obligatoire.')
---

<a class:list={['bib-carte-photo', classes(classe, className)]} href={url} style={fusionnerStyles(style)} {...reste}>
  {
    typeof image === 'string' ? (
      <img class="bib-carte-photo__photo" src={image} alt="" loading="lazy" decoding="async" />
    ) : (
      <Picture class="bib-carte-photo__photo" src={image} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
    )
  }
  <span class="bib-carte-photo__texte">
    <span class="bib-carte-photo__titre">{titre}</span>
    <span class="bib-carte-photo__description">{description}</span>
  </span>
  <span class="bib-carte-photo__fleche" aria-hidden="true"></span>
</a>
