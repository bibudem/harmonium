---
/* <TableauCorps> : un <tbody> (voir src/composants/tableau.css). */
import '../src/composants/tableau.css'
import { classes, fusionnerStyles } from './styles.ts'

interface Props {
  class?: string
  className?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { class: classe, className, style, ...reste } = Astro.props
---

<tbody class={classes(classe, className)} style={fusionnerStyles(style)} {...reste}><slot /></tbody>
