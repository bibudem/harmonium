---
/*
 * <Pano360> : une visite virtuelle 360° derrière un aperçu léger. Produit le HTML documenté dans
 * src/composants/pano360.css et importe cette feuille ; bib-pano360.min.js charge la visite au clic.
 *
 *   <Pano360 image="/img/pano/poste-edition.webp" apercu={apercu} alt="Vue en 360° du poste d'édition" titre="Poste d'édition" />
 *
 * `image` : le panorama équirectangulaire complet (chargé au clic seulement). `apercu` : une petite image
 * (le centre du panorama, image importée ou adresse), affichée avant le clic avec `alt`. `legende` : sinon
 * l'alt. `module` et `feuille` : adresses de photo-sphere-viewer si le site la sert lui-même.
 */
import '../src/composants/pano360.css'
import type { ImageMetadata } from 'astro'
import { Image as ImageAstro } from 'astro:assets'
import { idUnique } from './ids.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  image: string
  apercu: ImageMetadata | string
  alt: string
  titre?: string
  legende?: string
  module?: string
  feuille?: string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: Style
}

const { image, apercu, alt, titre, legende, module, feuille, class: classe, className, style } = Astro.props
if (!image || !apercu || !alt) throw new Error('Pano360 : les propriétés `image`, `apercu` et `alt` sont obligatoires.')

const id = idUnique('pano360')
const texte = legende || alt
const nom = titre ? `Visite virtuelle 360° : ${titre}` : 'Visite virtuelle 360°'
---

<figure
  class:list={['bib-pano360', classes(classe, className)]}
  style={fusionnerStyles(style)}
  data-pano360
  data-image={image}
  data-legende={texte}
  data-nom={nom}
  data-description={`${id}-legende`}
  data-module={module}
  data-feuille={feuille}
>
  <div class="bib-pano360__visionneuse" data-visionneuse>
    {
      typeof apercu === 'string' ? (
        <img class="bib-pano360__apercu" src={apercu} alt={alt} width="960" height="480" decoding="async" />
      ) : (
        <ImageAstro class="bib-pano360__apercu" src={apercu} alt={alt} widths={[480, 960]} sizes="(min-width: 900px) 800px, 100vw" />
      )
    }
    <button type="button" class="bib-pano360__demarrer" data-demarrer hidden>
      <svg viewBox="0 0 256 256" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M232,48V88a8,8,0,0,1-16,0V56H184a8,8,0,0,1,0-16h40A8,8,0,0,1,232,48ZM72,200H40V168a8,8,0,0,0-16,0v40a8,8,0,0,0,8,8H72a8,8,0,0,0,0-16Zm152-40a8,8,0,0,0-8,8v32H184a8,8,0,0,0,0,16h40a8,8,0,0,0,8-8V168A8,8,0,0,0,224,160ZM32,96a8,8,0,0,0,8-8V56H72a8,8,0,0,0,0-16H32a8,8,0,0,0-8,8V88A8,8,0,0,0,32,96ZM188,167l-56,32a8,8,0,0,1-7.94,0L68,167A8,8,0,0,1,64,160V96a8,8,0,0,1,4-7l56-32a8,8,0,0,1,7.94,0l56,32a8,8,0,0,1,4,7v64A8,8,0,0,1,188,167ZM88.12,96,128,118.79,167.88,96,128,73.21ZM80,155.36l40,22.85V132.64L80,109.79Zm96,0V109.79l-40,22.85v45.57Z" /></svg>
      <span>Démarrer la visite virtuelle<span class="bib-masque"> : {titre ?? alt}</span></span>
    </button>
    <p class="bib-pano360__etat" role="status" data-etat></p>
  </div>
  <figcaption class="bib-pano360__legende" id={`${id}-legende`}>
    {texte && <span>{texte}. </span>}
    <span data-aide hidden>Flèches pour tourner, + et − pour zoomer. </span>
    <a href={image}>Voir l’image panoramique à plat</a>
  </figcaption>
</figure>
