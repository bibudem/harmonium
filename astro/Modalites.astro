---
/*
 * <Modalites> : produit le HTML documenté dans src/composants/modalites.css et importe cette
 * feuille. Aucun JavaScript.
 *
 *   <Modalites>
 *     <Modalite Icon={BooksIcon}>Nombre maximum de documents : 100</Modalite>
 *   </Modalites>
 */
import '../src/composants/modalites.css'
import { classes } from './styles.ts'

interface Props {
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: string
}

const { class: classe, className, style } = Astro.props
---

<ul class:list={['bib-modalites', classes(classe, className)]} style={style}>
  <slot />
</ul>
