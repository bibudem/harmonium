---
/*
 * OBSOLÈTE depuis 1.2 : utiliser <ListeProfils> (src/composants/liste-profils.css). Conservé tel quel
 * pour les pages existantes ; retiré en 2.0.
 *
 * <Equipe> : la grille de vignettes d'une équipe. Produit le HTML documenté dans src/composants/equipe.css et
 * importe cette feuille (et carte-lien.css). Le site choisit et ordonne les personnes ; une équipe vide n'affiche
 * rien.
 *
 *   <Equipe nom="Équipe : Bibliothèque de droit" membres={[{ nomComplet: 'Marie Tremblay', fonction: 'bibliothécaire', url: '/equipe/?q=Marie%20Tremblay', photo }]} />
 *
 * Un membre : `nomComplet`, `fonction`, `url` (sa fiche) et `photo` (image importée ou adresse). `service` : un service
 * ou une équipe (Soutien informatique) plutôt qu'une personne ; une icône de groupe remplace la photo. `niveauTitre` :
 * niveau du nom (3 sous un titre de niveau 2).
 */
import '../src/composants/equipe.css'
import '../src/composants/carte-lien.css'
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { classes } from './styles.ts'

interface Membre {
  nomComplet: string
  fonction: string
  url: string
  photo?: ImageMetadata | string
  /** Un service ou une équipe plutôt qu'une personne : icône de groupe au lieu de la photo */
  service?: boolean
}

interface Props {
  membres: Membre[]
  /** Nom accessible de la liste */
  nom?: string
  niveauTitre?: 3 | 4 | 5
  class?: string
}

const { membres, nom = 'Équipe', niveauTitre = 3, class: classe } = Astro.props
const Titre = `h${niveauTitre}` as 'h3'
// Icône UsersThree de Phosphor
const ICONE_SERVICE = '<svg viewBox="0 0 256 256" width="1em" height="1em" fill="currentColor" aria-hidden="true" focusable="false"><path d="M244.8,150.4a8,8,0,0,1-11.2-1.6A51.6,51.6,0,0,0,192,128a8,8,0,0,1-7.37-4.89,8,8,0,0,1,0-6.22A8,8,0,0,1,192,112a24,24,0,1,0-23.24-30,8,8,0,1,1-15.5-4A40,40,0,1,1,219,117.51a67.94,67.94,0,0,1,27.43,21.68A8,8,0,0,1,244.8,150.4ZM190.92,212a8,8,0,1,1-13.84,8,57,57,0,0,0-98.16,0,8,8,0,1,1-13.84-8,72.06,72.06,0,0,1,33.74-29.92,48,48,0,1,1,58.36,0A72.06,72.06,0,0,1,190.92,212ZM128,176a32,32,0,1,0-32-32A32,32,0,0,0,128,176ZM72,120a8,8,0,0,0-8-8A24,24,0,1,1,87.24,82a8,8,0,1,0,15.5-4A40,40,0,1,0,37,117.51,67.94,67.94,0,0,0,9.6,139.19a8,8,0,1,0,12.8,9.61A51.6,51.6,0,0,1,64,128,8,8,0,0,0,72,120Z"/></svg>'
const majuscule = (t: string) => t.charAt(0).toUpperCase() + t.slice(1)
/** « Marie-Ève Tremblay » → « MT » : première lettre du premier et du dernier mot */
const initiales = (nomComplet: string) => {
  const mots = nomComplet.trim().split(/\s+/)
  return (mots[0].charAt(0) + (mots.length > 1 ? mots[mots.length - 1].charAt(0) : '')).toLocaleUpperCase('fr-CA')
}
---

{
  membres.length > 0 && (
    <ul class:list={['bib-equipe', classes(classe)]} aria-label={nom}>
      {membres.map((p) => (
        <li class="bib-equipe__vignette bib-carte-lien">
          {p.service && (
            <span class="bib-equipe__photo bib-equipe__photo--service" aria-hidden="true" set:html={ICONE_SERVICE} />
          )}
          {!p.photo && !p.service && (
            <span class="bib-equipe__photo bib-equipe__photo--initiales" aria-hidden="true">
              {initiales(p.nomComplet)}
            </span>
          )}
          {p.photo && !p.service &&
            (typeof p.photo === 'string' ? (
              <img class="bib-equipe__photo" src={p.photo} alt="" width="160" height="160" loading="lazy" decoding="async" />
            ) : (
              <Picture class="bib-equipe__photo" src={p.photo} alt="" width={160} height={160} densities={[1, 2]} fit="cover" position="center" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" />
            ))}
          <Titre class="bib-equipe__nom">
            <a class="bib-lien-etire" href={p.url}>
              {p.nomComplet}
            </a>
          </Titre>
          <p class="bib-equipe__fonction">{majuscule(p.fonction)}</p>
        </li>
      ))}
    </ul>
  )
}
