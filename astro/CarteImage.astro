---
/*
 * <CarteImage> : une carte-lien avec photo. Produit le HTML documenté dans src/composants/carte-image.css et
 * importe cette feuille (et carte-lien.css).
 *
 *   <CarteImage title="Services" Image={photo} href="/services/" moreText="En savoir plus" />
 *
 * `Image` : image importée (formats et tailles d'astro:assets) ou adresse. `niveauTitre` : 2 à 6 (3 par
 * défaut). `alt` : seulement si la photo porte un message. `surface` : carte blanche à contour.
 */
import '../src/composants/carte-image.css'
import type { ImageMetadata } from 'astro'
import { Image as ImageAstro } from 'astro:assets'
import '../src/composants/carte-lien.css'
import PastilleFleche from './PastilleFleche.astro'
import { classes, fusionnerStyles, type Style } from './styles.ts'
import { lienCarte } from './liens.ts'
import { idUnique } from './ids.ts'

interface Props {
  /** Carte blanche à contour et ombre, description sous le titre */
  surface?: boolean
  title: string
  Image: ImageMetadata | string
  href: string
  moreText?: string
  /** Texte de remplacement de la photo ; décorative par défaut */
  alt?: string
  niveauTitre?: 2 | 3 | 4 | 5 | 6
  target?: string
  rel?: string
  id?: string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: Style
}

const { title, Image, surface = false, href, moreText = 'En savoir plus', alt = '', niveauTitre = 3, target, rel, class: classe, className, style, ...reste } = Astro.props

if (title === undefined) throw new Error('CarteImage : la propriété `title` est obligatoire.')
if (!Image) throw new Error('CarteImage : la propriété `Image` est obligatoire.')
if (typeof href !== 'string' || !href.trim()) throw new Error('CarteImage : la propriété `href` doit être une chaîne.')

const { externe, afficherFleche, cible, rel: relFinal, annonce } = lienCarte(href, target, rel, Astro.site?.origin ?? Astro.url.origin)
const idPlus = moreText ? idUnique('carte-plus') : undefined
const Titre = `h${niveauTitre}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---

<div class:list={['bib-carte-image', { 'bib-carte-image--surface': surface }, 'bib-carte-lien', 'bib-anneau-carte', 'surface-claire', classes(classe, className)]} style={fusionnerStyles(style)} {...reste}>
  {
    typeof Image === 'string' ? (
      <img class="bib-carte-image__photo" src={Image} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <ImageAstro class="bib-carte-image__photo" src={Image} alt={alt} widths={[330, 660]} sizes="330px" loading="lazy" />
    )
  }
  <div class="bib-carte-image__contenu">
    <Titre class="bib-carte-image__titre">
      <a class="bib-lien-etire" href={href} target={cible} rel={relFinal} aria-describedby={idPlus}
        >{title}{annonce && <span class="bib-masque">{annonce}</span>}</a
      >
    </Titre>
    <div class="bib-carte-image__pied">
      {
        moreText && (
          <div class="bib-carte-image__plus" id={idPlus} aria-hidden="true">
            {moreText}
          </div>
        )
      }
      {afficherFleche && <PastilleFleche externe={externe} />}
    </div>
  </div>
</div>
