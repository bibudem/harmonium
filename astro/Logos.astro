---
/*
 * <Logos> : une grille de logos (<Logo>). Produit le HTML documenté dans src/composants/logos.css
 * et importe cette feuille.
 */
import '../src/composants/logos.css'
import { classes } from './styles.ts'

interface Props {
  class?: string
  /** Contenu repris de React */
  className?: string
}

const { class: classe, className } = Astro.props
---

<div class:list={['bib-logos', classes(classe, className)]}>
  <slot />
</div>
