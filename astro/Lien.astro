---
/*
 * <Lien> : produit le HTML documenté dans src/composants/lien.css et importe cette feuille.
 *
 *   <Lien href="/services/">Voir les services</Lien>
 *   <Lien href="/services/" Icone>Voir les services</Lien>
 *
 * Toujours un <a> ordinaire. `href` donne l'adresse ; sans adresse, pas de lien utile
 * (la propriété est exigée par le navigateur : « # »). Un PDF s'ouvre dans un nouvel onglet ;
 * PDF et nouvel onglet sont annoncés en texte masqué, et `target="_blank"` reçoit rel="noopener".
 *
 * - `Icon` : true pour la flèche →. Un composant d'icône (Phosphor…) passe tel quel, rendu avec
 *   `iconProps`.
 * - `flecheExterne` : un lien vers un autre site (hors famille des bibliothèques) porte la flèche ↗ et
 *   l'annonce « (lien externe) » (jamais pour un PDF, un courriel ni un téléphone). Désactivé par
 *   défaut.
 */
import '../src/composants/lien.css'
import { analyserLien, annonceLien, relDuLien, versAilleurs } from './liens.ts'
import { classes, fusionnerStyles, type Style } from './styles.ts'


interface Props {
  href?: string
  /** true = flèche ; sinon un composant d'icône */
  Icone?: boolean | any
  proprietesIcone?: Record<string, unknown>
  /** Flèche ↗ et annonce vers un autre site */
  flecheExterne?: boolean
  target?: string
  rel?: string
  /** Attribut HTML title du lien */
  title?: string
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { href, Icone: Icon, proprietesIcone: iconProps, flecheExterne = false, target, rel, class: classe, style, ...reste } = Astro.props
const adresse = href
if (!adresse?.trim()) throw new Error('Lien : une adresse non vide est requise.')
const analyse = analyserLien(adresse, Astro.site?.origin ?? Astro.url.origin)
const cible = analyse.pdf ? '_blank' : target
const nouvelOnglet = cible === '_blank'
const relFinal = nouvelOnglet ? relDuLien(rel, true, true) : rel
const externe = flecheExterne && versAilleurs(analyse, nouvelOnglet)
const annonce = annonceLien({ pdf: analyse.pdf, nouvelOnglet }) || (externe ? ' (lien externe)' : '')
const Icone = Icon === true ? null : Icon || null
const fleche = Icon === true || externe
---

<a
  href={adresse}
  target={cible}
  rel={relFinal}
  class:list={['bib-lien', { 'bib-lien--icone': Icone || Icon === true }, classes(classe)]}
  style={fusionnerStyles(style)}
  {...reste}
  ><slot />{annonce && <span class="bib-masque">{annonce}</span>}{
    Icone ? <Icone size="1.125rem" color="currentColor" {...iconProps} aria-hidden="true" focusable="false" /> : fleche && <span class:list={['bib-lien__icone', { 'bib-lien__icone--externe': externe }]} aria-hidden="true" />
  }</a
>
