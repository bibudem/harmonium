---
/*
 * <Section> : bande pleine largeur. Produit le HTML documenté dans src/composants/section.css
 * et importe cette feuille.
 *
 *   <Section couleur="vertFonce">…</Section>
 *   <Section image={photo} imageAlt="">…</Section>
 *
 * - `couleur` : clé de couleur du thème (voir fonds.ts) ; son ton règle texte, liens et focus.
 * - `image` : photo en fond (cover) sous un voile noir, texte blanc ; une image importée passe
 *   par <Picture> (formats et tailles d'astro:assets), une chaîne par un <img>.
 *   `voile="droite"` : dès 900 px, photo à gauche sans voile, texte sur le bleu principal.
 * - `margeHaut`, `suite`, `largeurFixe`, `hauteurMin`, `alignementTexte` : voir la fiche.
 * - `revelation` : pose data-revelation sur l'intérieur, pour l'animation d'apparition du site.
 */
import '../src/composants/section.css'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { classes, fusionnerStyles, type Style } from './styles.ts'
import { FONDS } from './fonds.ts'


interface Props {
  couleur?: string
  image?: ImageMetadata | string
  /** Texte de remplacement de l'image ; décorative par défaut */
  imageAlt?: string
  /** Voile sous le texte : uniforme (par défaut) ou foncé à droite seulement dès 900 px */
  voile?: 'uniforme' | 'droite'
  margeHaut?: boolean | string
  suite?: boolean
  revelation?: boolean
  largeurFixe?: boolean
  hauteurMin?: string
  alignementTexte?: 'gauche' | 'centre' | 'droite'
  id?: string
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { couleur: bg, image, imageAlt = '', voile = 'uniforme', margeHaut: marginTop, suite = false, revelation = false, largeurFixe: fixedWidth = false, hauteurMin: minHeight, alignementTexte: textAlign, id, class: classe, style, ...reste } = Astro.props

if (bg && image) throw new Error('Section : les propriétés `image` et `couleur` sont mutuellement exclusives.')
const fond = bg ? FONDS[bg as keyof typeof FONDS] : undefined
if (bg && !fond) throw new Error(`Section : la couleur « ${bg} » n'existe pas dans le thème (${Object.keys(FONDS).join(', ')}).`)

const ton = image ? undefined : fond?.ton
const margeHaut = marginTop !== undefined && marginTop !== false && marginTop !== 'false'
---

<section
  id={id}
  class:list={[
    'bib-section',
    fond && `bib-section--${fond.modificateur}`,
    ton && `bib-section--${ton}`,
    ton === 'moyen' && 'theme-clair',
    (ton === 'fonce' || image) && 'surface-foncee',
    { 'bib-section--image': image, 'bib-section--voile-droite': image && voile === 'droite', 'bib-section--marge-haut': margeHaut, 'bib-section--suite': suite, 'bib-section--largeur-fixe': fixedWidth },
    classes(classe),
  ]}
  style={fusionnerStyles({ minHeight: minHeight !== 'auto' ? minHeight : undefined, textAlign: textAlign ? ({ gauche: 'left', centre: 'center', droite: 'right' } as Record<string, string>)[textAlign] : undefined }, style)}
  {...reste}
>
  {
    image &&
      (typeof image === 'string' ? (
        <img class="bib-section__image" src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <Picture
          class="bib-section__image"
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1920, 2400].filter((l) => l <= image.width)}
          sizes="100vw"
          alt={imageAlt}
          loading="lazy"
        />
      ))
  }
  <div class="bib-section__interieur" data-revelation={revelation ? 'zone' : undefined}><slot /></div>
</section>
