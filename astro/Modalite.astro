---
/*
 * <Modalite> : une ligne de <Modalites> (voir src/composants/modalites.css). L'icône est
 * décorative. Elle se donne par `Icon` (un composant d'icône, rendu directement) ou par le
 * slot « icone » (une icône prête : SVG, planche d'icônes du site). Le slot l'emporte.
 */
import { classes } from './styles.ts'
interface Props {
  /** Composant d'icône (Phosphor ou icône maison) */
  Icon?: any
  /** Taille de l'icône en px */
  taille?: number
  /** Couleur CSS de l'icône, de préférence un jeton ; celle du texte par défaut */
  couleur?: string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: string
}

const { Icon, taille = 32, couleur = 'currentColor', class: classe, className, style } = Astro.props
---

<li class:list={['bib-modalite', classes(classe, className)]} style={style}>
  <span class="bib-modalite__icone" aria-hidden="true">
    <slot name="icone">{Icon && <Icon size={taille} color={couleur} aria-hidden="true" focusable="false" />}</slot>
  </span>
  <span class="bib-modalite__texte"><slot /></span>
</li>
