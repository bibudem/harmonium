---
/*
 * <Banniere> : une photo sous un voile, avec le titre de la page (<h1>) en bas à gauche. Produit le HTML
 * documenté dans src/composants/banniere.css et importe cette feuille (et typographie.css).
 *
 *   <Banniere titre="Les bibliothèques" image={photo} sousTitre="Étudier, chercher, créer." />
 *   <Banniere variante="section" titre="Études" image={photo} />
 *
 * - `image` : image importée (formats et tailles d'astro:assets : l'image est chargée en priorité) ou adresse ;
 *   `alt` : seulement si elle porte un message (décorative par défaut) ; `cadrage` : hauteur de la photo à garder
 *   (« 20 % »). En petit format sans cadrage, la photo est recadrée à la construction en 5:2.
 * - `taille="petite"` : 15 / 16 / 18 rem. `vague` : dégradé bleu foncé à la place du voile noir. `titreReduit` :
 *   police réduite (aussi automatique au-delà de 45 caractères).
 * - Sous-titre : propriété `sousTitre` ou slot « sousTitre ». Le contenu par défaut (sommaire, boutons) passe
 *   sous le texte. `variante="section"` : bande basse des sous-pages, titre en paragraphe (apparence h2).
 * - Placement : variables --bib-banniere-entete et --bib-banniere-marge-basse (voir la fiche).
 */
import '../src/composants/banniere.css'
import '../src/composants/typographie.css'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { classes, fusionnerStyles, type Style } from './styles.ts'


interface Props {
  titre?: string
  /** Texte sous le titre (aussi possible en slot « sousTitre ») */
  sousTitre?: string
  /** Image importée ou adresse. Obligatoire. */
  image: ImageMetadata | string
  /** Texte de remplacement ; décorative par défaut */
  alt?: string
  /** Hauteur de la photo à garder au recadrage (« 20% ») ; le centre par défaut */
  cadrage?: string
  taille?: 'normale' | 'petite'
  /** Dégradé bleu foncé à la place du voile noir uniforme */
  vague?: boolean
  /** Police réduite pour le titre, comme un titre long */
  titreReduit?: boolean
  variante?: 'page' | 'section'
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { titre: title, sousTitre: subTitle, image, alt = '', cadrage, taille = 'normale', vague = true, titreReduit = false, variante = 'page', class: classe, style, ...reste } = Astro.props
if (taille !== 'normale' && taille !== 'petite') throw new Error('Banniere : `taille` vaut « normale » ou « petite ».')
if (!image) throw new Error('Banniere : la propriété `image` est obligatoire.')
const section = variante === 'section'
const aSousTitre = !section && (subTitle !== undefined || Astro.slots.has('sousTitre'))
const aEnfants = !section && Astro.slots.has('default')
const recadree = taille === 'petite' && !cadrage && typeof image !== 'string'
const recadrage = recadree ? { width: (image as ImageMetadata).width, height: Math.round((image as ImageMetadata).width / 2.5), fit: 'cover' as const, position: 'center' } : {}
const TITRE_LONG = 45
const titreLong = titreReduit || (typeof title === 'string' && title.length > TITRE_LONG)
const Balise = section ? 'section' : 'div'
---

<Balise
  class:list={['bib-banniere', 'surface-foncee', { 'bib-banniere--vague': vague, 'bib-banniere--petite': taille === 'petite', 'bib-banniere--titre-long': titreLong, 'bib-banniere--section': section }, classes(classe)]}
  style={fusionnerStyles(cadrage && { '--bib-banniere-cadrage': cadrage }, style)}
  aria-label={section ? title : undefined}
  {...reste}
>
  {
    typeof image === 'string' ? (
      <img class="bib-banniere__image" src={image} alt={alt} loading="eager" fetchpriority="high" />
    ) : (
      <Picture class="bib-banniere__image" src={image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280, 1600, 1920, 2400].filter((l) => l <= image.width)} sizes="100vw" {...recadrage} alt={alt} loading="eager" fetchpriority="high" />
    )
  }
  <div class="bib-banniere__texte">
    <div class="bib-banniere__colonne">
      {
        section ? (
          <p class="bib-banniere__titre-section">{title}</p>
        ) : (
          <h1 class:list={['bib-typographie', `bib-typographie--${taille === 'petite' ? 'titre-banniere-petit' : 'titre-banniere'}`, 'bib-banniere__titre']}>{title}</h1>
        )
      }
      {
        aSousTitre && (
          <div class="bib-banniere__sous-titre">
            <slot name="sousTitre">{subTitle}</slot>
          </div>
        )
      }
    </div>
  </div>
  {
    aEnfants && (
      <div class="bib-banniere__enfants">
        <slot />
      </div>
    )
  }
</Balise>
