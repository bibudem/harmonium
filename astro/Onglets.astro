---
/*
 * <Onglets> : un jeu d'onglets. Produit le HTML documenté dans src/composants/onglets.css et importe cette
 * feuille ; bib-onglets.min.js (facultatif) le rend interactif. Chaque enfant de premier niveau du slot est un
 * panneau, dans l'ordre de `tabs`.
 *
 *   <Onglets tabs={['Prêt', 'Retour']} niveauTitre={3}>
 *     <div>…</div>
 *     <div>…</div>
 *   </Onglets>
 *
 * - `defaultTab` : onglet ouvert au départ, compté à partir de 1. `horizontal` : la rangée reste au-dessus du
 *   contenu à toutes les largeurs (sous 900 px, les panneaux défilent à l'horizontale). `compact` (avec
 *   `horizontal`) : la rangée placée dans le texte d'une page, alignée à gauche et moins haute.
 * - `niveauTitre` : niveau du titre de chaque panneau, dans le rendu sans JavaScript (h3 : les onglets suivent
 *   d'ordinaire le h2 de leur section). Un jeu imbriqué dans un panneau descend ses titres d'un cran.
 * - Jeux synchronisés : `groupe` lie tous les jeux de la page qui portent le même nom ; `valeurs` donne la
 *   valeur de chaque onglet (sinon son libellé) ; `url` écrit aussi le choix dans l'adresse (?groupe=valeur).
 * - Couleurs : --bib-onglets-texte et --bib-onglets-accent, à redéfinir dans `style` sur un fond foncé.
 */
import '../src/composants/onglets.css'
import { classes, fusionnerStyles, type Style } from './styles.ts'
import { panneauxDuSlot } from './decoupage.ts'
import { idUnique } from './ids.ts'

interface Props {
  /** Libellés des onglets, dans l'ordre des panneaux */
  tabs?: string[]
  /** Onglet ouvert au départ, compté à partir de 1 */
  defaultTab?: number
  ariaLabel?: string
  niveauTitre?: 2 | 3 | 4 | 5 | 6
  /** Onglets en rangée au-dessus du contenu à toutes les largeurs */
  horizontal?: boolean
  /** Avec `horizontal` : rangée alignée à gauche et moins haute */
  compact?: boolean
  /** Valeur de chaque onglet, dans l'ordre (sinon le libellé) */
  valeurs?: string[]
  /** Nom du groupe de jeux synchronisés */
  groupe?: string
  /** Le choix du groupe s'écrit aussi dans l'adresse (?groupe=valeur) */
  url?: boolean
  /** Accepté pour la compatibilité du contenu ; sans effet */
  bg?: string
  id?: string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { tabs = [], defaultTab = 1, ariaLabel, niveauTitre = 3, horizontal = false, compact = false, valeurs = [], groupe, url = false, bg: _bg, sx: _sx, class: classe, className, style, ...reste } = Astro.props
const prefixe = idUnique('onglets')
const { panneaux, annexes } = panneauxDuSlot(Astro.slots.has('default') ? await Astro.slots.render('default') : '')
// Un libellé sans panneau ne donnerait qu'un onglet vide : on s'en tient aux paires
const nombre = Math.min(tabs.length, panneaux.length)
const actif = Math.min(Math.max(Number(defaultTab) - 1 || 0, 0), Math.max(nombre - 1, 0))
const Titre = `h${niveauTitre}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---

<div
  class:list={['bib-onglets', { 'bib-onglets--horizontal': horizontal, 'bib-onglets--compact': horizontal && compact }, classes(classe, className)]}
  style={fusionnerStyles(style)}
  data-onglets
  data-orientation-large={horizontal ? 'horizontal' : 'vertical'}
  data-groupe={groupe || undefined}
  data-url={groupe && url ? '' : undefined}
  {...reste}
>
  <div class="bib-onglets__liste" data-onglets-liste data-aria-label={ariaLabel || undefined}>
    {/* Pastille de l'onglet actif, glissée par le script dans le carrousel mobile des onglets horizontaux */}
    {horizontal && <span class="bib-onglets__indicateur" aria-hidden="true" data-indicateur />}
    {
      tabs.slice(0, nombre).map((libelle, i) => (
        <button
          type="button"
          class="bib-onglets__onglet"
          data-onglet
          id={`${prefixe}-onglet-${i + 1}`}
          aria-controls={`${prefixe}-panneau-${i + 1}`}
          data-selectionne={String(i === actif)}
          data-valeur={groupe ? (valeurs[i] ?? libelle) : undefined}
        >
          {libelle}
        </button>
      ))
    }
  </div>
  <div class="bib-onglets__panneaux">
    {
      panneaux.slice(0, nombre).map((contenu, i) => (
        <div class="bib-onglets__panneau" id={`${prefixe}-panneau-${i + 1}`} data-selectionne={String(i === actif)}>
          <Titre class="bib-onglets__titre-panneau" data-titre-panneau>
            {tabs[i]}
          </Titre>
          <Fragment set:html={contenu} />
        </div>
      ))
    }
  </div>
  <Fragment set:html={annexes} />
</div>
