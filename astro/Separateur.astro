---
/*
 * <Separateur> : produit le HTML documenté dans src/composants/separateur.css et importe cette
 * feuille. Aucun JavaScript.
 *
 *   <Separateur />
 *   <Separateur orientation="vertical" />   (dans une rangée flex)
 */
import '../src/composants/separateur.css'
import { classes, fusionnerStyles } from './styles.ts'


interface Props {
  orientation?: 'horizontal' | 'vertical'
  class?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { orientation = 'horizontal', class: classe, style, ...reste } = Astro.props
const vertical = orientation === 'vertical'
---

<hr
  class:list={['bib-separateur', { 'bib-separateur--vertical': vertical }, classes(classe)]}
  aria-orientation={vertical ? 'vertical' : undefined}
  style={fusionnerStyles(style)}
  {...reste}
/>
