---
/*
 * <AccordeonContenu> : le contenu d'un volet (voir src/composants/accordeons.css), sur le fond de
 * la couleur du groupe. Aussi : AccordeonDetails (ancien nom).
 */
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  id?: string
  class?: string
  /** Contenu repris de React */
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { class: classe, className, style, sx: _sx, ...reste } = Astro.props
---

<div class:list={['bib-accordeon__contenu', classes(classe, className)]} style={fusionnerStyles(style)} {...reste}>
  <slot />
</div>
