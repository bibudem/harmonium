---
/*
 * <AccordeonContenu> : le contenu d'un volet (voir src/composants/accordeons.css), sur le fond de
 * la couleur du groupe.
 */
import { classes, fusionnerStyles, type Style } from './styles.ts'

interface Props {
  id?: string
  class?: string
  style?: Style
  [attribut: string]: unknown
}

const { class: classe, style, ...reste } = Astro.props
---

<div class:list={['bib-accordeon__contenu', classes(classe)]} style={fusionnerStyles(style)} {...reste}>
  <slot />
</div>
