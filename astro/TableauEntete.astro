---
/* <TableauEntete> : un <thead> dont les cellules deviennent des <th scope="col"> (voir src/composants/tableau.css). */
import '../src/composants/tableau.css'
import { entetesDeColonne } from './semantique-tableau.ts'
import { classes, fusionnerStyles } from './styles.ts'

interface Props {
  class?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { class: classe, style, ...reste } = Astro.props
const contenu = entetesDeColonne(Astro.slots.has('default') ? await Astro.slots.render('default') : '')
---

<thead class={classes(classe)} style={fusionnerStyles(style)} {...reste} set:html={contenu}></thead>
